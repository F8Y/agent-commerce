# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Telegram ---
# Токен своего dev-бота от BotFather. Один токен = один запущенный экземпляр.
TELEGRAM_BOT_TOKEN=
# Числовые ID пользователей Telegram через запятую. Пусто = бот никому не отвечает.
TELEGRAM_ALLOWED_USERS=
# Если Telegram недоступен напрямую:
# TELEGRAM_PROXY=socks5://host.docker.internal:1080

# --- Модель: любой OpenAI-совместимый эндпоинт ---
# Имя модели задаётся в hermes/config.yaml (model.default).
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- Внутренний токен между hermes и marketplace ---
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MARKETPLACE_MCP_TOKEN=

# --- Версия Hermes ---
# После первого удачного запуска закрепите конкретный тег вместо stable.
HERMES_TAG=stable

# --- Версия Playwright MCP ---
# После первого удачного запуска закрепите конкретный тег вместо latest.
PLAYWRIGHT_MCP_TAG=latest
